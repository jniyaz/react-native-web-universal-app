{
  "name": "@myapp/expo",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "dev:go": "expo start --go",
    "start": "expo start",
    "build": "cross-env EXPO_NO_TELEMETRY=1 expo export",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:development:android": "eas build --profile development --platform android",
    "postinstall": "cd ../.. && yarn patch-package"
  },
  "dependencies": {
    "app": "*",
    "@expo/metro-runtime": "~4.0.1",
    "expo": "~52.0.0",
    "expo-dev-client": "~5.0.0",
    "expo-linking": "~7.0.3",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.26.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/metro-config": "~0.19.12",
    "@types/react": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
