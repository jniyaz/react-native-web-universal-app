{
  "name": "mono-repo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "^18.3.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && yarn clean:build",
    "clean:build": "rm -rf apps/next/.next apps/expo/.expo node_modules/.cache/turbo",
    "native": "yarn workspace @myapp/expo dev",
    "native:go": "yarn workspace @myapp/expo dev:go",
    "android": "yarn workspace @myapp/expo android",
    "web": "yarn workspace @myapp/next dev",
    "postinstall": "patch-package && husky install"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "husky": "^8.0.3",
    "patch-package": "^6.5.1",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "turbo": "^2.11.7",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
